NODE endpoint
SQL >
    %
    SELECT 
        timestamp,
        userId,
        eventType,
        mediaType,
        postId,
        authorId,
        watchSeconds,
        watchPercent,
        duration,
        replayCount,
        scrollVelocity,
        scoreWeight,
        actionType,
        city,
        country,
        deviceModel
    FROM user_behavior_telemetry
    WHERE 1=1
    {% if defined(selected_user) and String(selected_user) != '' %}
        AND userId = {{ String(selected_user) }}
    {% end %}
    ORDER BY timestamp DESC

TYPE endpoint

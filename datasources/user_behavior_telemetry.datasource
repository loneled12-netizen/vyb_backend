SCHEMA >
    `timestamp` DateTime,
    `userId` String,
    `eventType` String,
    `mediaType` String,
    `postId` String,
    `authorId` String,
    `watchSeconds` Float32,
    `watchPercent` Float32,
    `duration` Float32,
    `replayCount` Int32,
    `scrollVelocity` Float32,
    `scoreWeight` Int32,
    `actionType` Int32,
    `city` String,
    `country` String,
    `deviceModel` String

ENGINE "MergeTree"
ENGINE_SORTING_KEY "timestamp, userId, eventType"
ENGINE_PARTITION_KEY "toYYYYMM(timestamp)"
